#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/../../.." && pwd )"

# 1. Start Backend if not already active
if ! lsof -i :8000 > /dev/null 2>&1; then
    cd "$DIR/backend"
    "$DIR/backend/.venv/bin/uvicorn" main:app --host 0.0.0.0 --port 8000 > /dev/null 2>&1 &
fi

# 2. Start Frontend if not already active
if ! lsof -i :3000 > /dev/null 2>&1; then
    cd "$DIR/frontend"
    npm run dev > /dev/null 2>&1 &
fi

# 3. Wait for services to be ready
sleep 2

# 4. Open directly in Chrome App Mode (frameless window) or default browser
if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="http://localhost:3000/live-scan"
else
    open "http://localhost:3000/live-scan"
fi
