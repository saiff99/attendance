# ==========================================
# MedAttend Frontend Environment Variables
# ==========================================

# 1. Supabase Credentials (Found in Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 2. Local or Production AI Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# 3. Security: Cryptographic Session Secret & Internal API Key
# Generate using: openssl rand -hex 32
AUTH_SECRET=your_32_byte_hex_session_secret_key_here
INTERNAL_API_KEY=your_32_byte_hex_internal_api_key_here

# 4. User Password Hashes (Bcrypt Salted Hashes)
# Generate using bcrypt: bcrypt.hashSync("your_password", 10)
ADMIN_PASSWORD_HASH=$2b$10$your_admin_bcrypt_hash_here
SAIF_PASSWORD_HASH=$2b$10$your_saif_bcrypt_hash_here
FACULTY_PASSWORD_HASH=$2b$10$your_faculty_bcrypt_hash_here
