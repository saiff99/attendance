# ==========================================
# MedAttend Frontend Environment Variables
# ==========================================

# Supabase Credentials (Found in Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Local or Production AI Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Security: Internal Shared API Key for Backend Communication
INTERNAL_API_KEY=medattend-internal-secret-token-key-2026
NEXT_PUBLIC_INTERNAL_API_KEY=medattend-internal-secret-token-key-2026

