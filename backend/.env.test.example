# ==========================================
# MedAttend AI Backend Test Environment Variables
# ==========================================
# Use this configuration for testing and CI/CD pipelines.
# Do NOT place production secrets in this file.

# 1. Test Supabase Database (Isolated / Local instance)
SUPABASE_URL=https://test-project-id.supabase.co
SUPABASE_KEY=test_service_role_key_example_12345
SUPABASE_SERVICE_ROLE_KEY=test_service_role_key_example_12345

# 2. Camera Configuration for Testing
# Set to "0" for mock/local testing or omit
CCTV_URLS="0"
PTZ_URLS="0"

# 3. Security & Test Internal API Key
INTERNAL_API_KEY=test_internal_api_key_32_bytes_hex_abc1234567890
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 4. Safe Test Flags
# When set to 1, allows test scripts to perform ephemeral test writes with immediate cleanup
ALLOW_TEST_DB_WRITE=0
